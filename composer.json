{
    "name": "laraviz/laraviz",
    "description": "Interactive canvas-based visualization of your entire Laravel application — database, routes, services, events, and flow.",
    "keywords": ["laravel", "visualization", "canvas", "database", "routes", "debug", "dev-tools"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/topdogfound/laraviz",
    "authors": [
        {
            "name": "LaraViz",
            "email": "hello@laraviz.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/topdogfound/laraviz/issues",
        "source": "https://github.com/topdogfound/laraviz"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "LaraViz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraViz\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraViz\\LaraVizServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
